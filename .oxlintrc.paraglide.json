{
  "plugins": [],
  "jsPlugins": [
    {
      "name": "paraglide",
      "specifier": "@inlang/paraglide-js/eslint"
    }
  ],
  "ignorePatterns": [
    "src/shared/lib/translations/**"
  ],
  "rules": {
    "paraglide/no-dynamic-message-access": [
      "error",
      {
        "messageModuleDirectories": [
          "translations"
        ]
      }
    ]
  }
}
